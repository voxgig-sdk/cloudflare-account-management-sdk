# BasicZoneFlow

main: kit: flow: BasicZoneFlow:
{
  entity: "zone",
  kind: "basic",
  name: "BasicZoneFlow",
  step: [
    {
      i: {
        ref: "zone_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "zone_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "zone_ref01",
        srcdatavar: "zone_ref01_data",
        suffix: "_up0",
        textfield: "name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-zone_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "zone_ref01",
        srcdatavar: "zone_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "zone01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-zone_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "zone_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "zone01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "zone_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicZoneFlow"
}